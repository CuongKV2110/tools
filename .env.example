# ============================================================
#  Firebase — Client SDK (public, safe to expose to browser)
#  Project Settings → General → Your apps → SDK setup
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase project id — also used server-side to verify Firebase ID tokens (JWKS).
# (No service account / Admin SDK needed.)
FIREBASE_PROJECT_ID=

# ============================================================
#  Google Gemini  (free key: https://aistudio.google.com/apikey)
# ============================================================
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional overrides
GEMINI_CONTENT_MODEL=gemini-flash-latest
GEMINI_CHAT_MODEL=gemini-flash-latest

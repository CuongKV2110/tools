rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // On create, the new doc must belong to the caller.
    function ownsNew() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }
    // On read/update/delete, the existing doc must belong to the caller.
    function ownsExisting() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /contents/{contentId} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsNew();
    }
  }
}
